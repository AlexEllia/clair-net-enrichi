# Secret : la cle ElevenLabs ne va jamais dans le depot.
config/secrets.env

# Fichier de controle de Cowork : sa presence bloque la generation audio.
# Jamais versionne - un retour en arriere pourrait le faire disparaitre et
# debloquer une generation.
episodes/*/STOP

# Medias lourds : voix sources et rendus. Ils restent dans le dossier ; le
# depot garde ce qui permet de les refaire et de verifier le moteur (scripts,
# durees, alignements, code, references de non-regression).
*.wav
*.mp3
*.mp4
# Exception : la musique de la charte (config/charte.json) fait partie du
# depot tant qu'un morceau reste sous 10 Mo.
!assets/musique/*.mp3
# Images de build des episodes (rendus, gabarits) : regenerables.
episodes/**/*.png

# Sorties regenerables (media/ : cache de textes de Manim, cree la ou on le lance)
episodes/*/build/
build/
episodes/*/video/
media/
video/media_exemple/
__pycache__/
*.pyc
